# Producción
NODE_ENV=production
ADMIN_ACCESS_CODE=reemplazar-por-un-codigo-largo-y-secreto
MULTIMEDIA_ACCESS_CODE=reemplazar-por-un-codigo-compartido
ESCENARIO_ACCESS_CODE=reemplazar-por-un-codigo-compartido

# Render con disco persistente montado en /var/data
DATABASE_PATH=/var/data/staff-mb.sqlite

# URL pública del servicio, sin barra final
PUBLIC_URL=https://staff-mb.onrender.com

# Render asigna PORT automáticamente. Para desarrollo local puede omitirse.
# PORT=3000
